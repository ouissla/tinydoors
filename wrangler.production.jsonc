{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinydoors",
  "main": "server/production.js",
  "keep_vars": true,
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "routes": [
    { "pattern": "tinydoors.app", "custom_domain": true },
    { "pattern": "www.tinydoors.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
