# Copy to .env for local Wrangler development. .env is ignored by Git.
# Cloud mode uses Supabase accounts and Stripe; prototype mode uses local IndexedDB.
# Upload runtime secrets to Cloudflare separately; deploying does NOT upload this file.

# prototype keeps the existing browser-only demo. Set cloud only after applying the migration.
APP_MODE=prototype

# Your final HTTPS site origin, without a trailing slash.
APP_URL=https://tinydoors.app

# Supabase dashboard > Project Settings > API Keys / Data API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public project key. Legacy anon key also works for the browser client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only: never include in browser scripts, HTML, or public build variables.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=calendar-photos

# Stripe: use test mode until the complete purchase flow has been verified.
# Hosted Stripe Checkout needs a server secret and a Price ID, not a browser publishable key.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_SEASON_PASS_PRICE_ID=price_REPLACE_ME
# Optional local-currency prices (one Stripe Price each, same product). Visitors are charged in their
# country's currency; any currency left unset falls back to the AUD price above. Amounts are fixed in
# server/pricing.js: USD 4.99, EUR 4.99, GBP 3.99, CAD 6.99, NZD 7.99, CHF 4.90.
STRIPE_SEASON_PASS_PRICE_ID_USD=price_REPLACE_ME
STRIPE_SEASON_PASS_PRICE_ID_EUR=price_REPLACE_ME
STRIPE_SEASON_PASS_PRICE_ID_GBP=price_REPLACE_ME
STRIPE_SEASON_PASS_PRICE_ID_CAD=price_REPLACE_ME
STRIPE_SEASON_PASS_PRICE_ID_NZD=price_REPLACE_ME
STRIPE_SEASON_PASS_PRICE_ID_CHF=price_REPLACE_ME
# Signing secret for /api/stripe/webhook; CLI and deployed endpoint secrets differ.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional for unattended Cloudflare deployments. Local wrangler login can be used instead.
# These two are deployment credentials, not Worker runtime secrets.
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
CLOUDFLARE_API_TOKEN=REPLACE_ME
